{
  "name": "umamusume-betting-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Umamusume Prediction & Betting Platform",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "seed": "cd backend && npm run seed",
    "build": "concurrently \"cd backend && npm run build\" \"cd frontend && npm run build\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
